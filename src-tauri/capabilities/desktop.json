{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-extras",
  "description": "Desktop-only permissions. Feature-scoped plugin permissions live here; default.json stays minimal.",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "updater:default",
    "process:default",
    "store:default",
    "opener:default",
    "opener:allow-open-path",
    "notification:default"
  ]
}
